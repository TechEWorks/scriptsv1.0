#!/usr/bin/env bash
# ServOS keeps this command; product scripts live in the public release catalog.
set -Eeuo pipefail
repo=https://github.com/TechEWorks/release.git
base=/usr/lib/teche/scriptsv1.0
current=$base/current
stage=''
refresh_started=0
refresh_succeeded=0
log_event() {
  local result=$1 root=/techev1.0/servosv1.0/logs file
  (( $(id -u) == 0 )) || return 0
  for file in "$root/operations/teche.log" "$root/audit/actions.log"; do
    [[ -d ${file%/*} ]] || continue
    (umask 077; printf '%s action=scriptsv1.0-refresh result=%s\n' \
      "$(date -u '+%Y.%m.%d %H.%M.%S UTC')" "$result" >> "$file")
  done
}
cleanup() {
  if (( refresh_started && ! refresh_succeeded )); then log_event failed; fi
  [[ -z $stage ]] || rm -rf -- "$stage"
}
trap cleanup EXIT

usage() {
  cat <<'EOF'
TechE v1.0 bootstrap (scripts not yet installed)
  teche help | --help | -help Show available bootstrap commands.
  teche get scriptsv1.0       Fetch, verify and activate public scripts.
  teche update scriptsv1.0    Refresh the same scripts.
  teche get scripts           Alias for get scriptsv1.0.
  teche update scripts        Alias for update scriptsv1.0.
  teche ver | --version       Show installed scripts version.
Run teche help after installation for all product commands.
EOF
}
verify_tree() {
  local dir=$1 line rel hash actual count=0
  local -A listed=()
  [[ -d $dir && ! -L $dir && -f $dir/VERSION &&
     -f $dir/SHA256SUMS.txt && -x $dir/bin/teche &&
     -x $dir/lib/wd1.0-menu.sh && -x $dir/lib/wd1.0-uninstall.sh &&
     -f $dir/bootstrap/teche ]] || return 65
  [[ $(cat "$dir/VERSION") =~ ^1\.0\.[0-9]+(-qa)?$ ]] || return 65
  while IFS= read -r line || [[ -n $line ]]; do
    [[ $line =~ ^([0-9a-f]{64})[[:space:]][[:space:]]([A-Za-z0-9._/-]+)$ ]] || return 65
    hash=${BASH_REMATCH[1]}
    rel=${BASH_REMATCH[2]}
    [[ $rel != /* && $rel != *..* && $rel != *//* &&
       -z ${listed[$rel]+x} && -f $dir/$rel && ! -L $dir/$rel ]] || return 65
    listed[$rel]=1
    actual=$(sha256sum "$dir/$rel")
    [[ ${actual%% *} == "$hash" ]] || return 65
    ((count+=1))
  done < "$dir/SHA256SUMS.txt"
  while IFS= read -r rel; do
    rel=${rel#"$dir/"}
    [[ $rel == SHA256SUMS.txt || -n ${listed[$rel]+x} ]] || return 65
  done < <(find "$dir" -type f)
  [[ -z $(find "$dir" -type l -print -quit) && $count -gt 0 ]] || return 65
  bash -n "$dir/bin/teche"
  bash -n "$dir/bootstrap/teche"
  for rel in "$dir"/lib/*.sh; do
    [[ ! -f $rel ]] || bash -n "$rel"
  done
}
refresh() {
  local src commit release candidate link old backup
  if (( $(id -u) != 0 )); then
    command -v sudo >/dev/null || { echo 'sudo is required.' >&2; return 77; }
    exec sudo -- "$0" "$@"
  fi
  refresh_started=1
  log_event started
  if ! command -v git >/dev/null; then
    command -v apt-get >/dev/null || { echo 'git is required.' >&2; return 69; }
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends git
  fi
  for old in sha256sum mktemp find cp mv ln; do
    command -v "$old" >/dev/null || { echo "Missing $old" >&2; return 69; }
  done
  stage=$(mktemp -d /var/tmp/teche-scriptsv1.0.XXXXXXXX)
  git clone --depth 1 --filter=blob:none --sparse "$repo" "$stage/repo"
  git -C "$stage/repo" sparse-checkout set scriptsv1.0
  src=$stage/repo/scriptsv1.0
  verify_tree "$src" || { echo 'Public scripts failed verification.' >&2; return 65; }
  commit=$(git -C "$stage/repo" rev-parse --verify HEAD)
  release=$base/releases/$commit
  install -d -m 0755 "$base/releases"
  if [[ ! -e $release ]]; then
    candidate=$(mktemp -d "$base/releases/.incoming.XXXXXXXX")
    cp -a -- "$src/." "$candidate/"
    verify_tree "$candidate" || { echo 'Staged scripts failed verification.' >&2; return 65; }
    mv -- "$candidate" "$release"
  else
    verify_tree "$release" || { echo 'Existing scripts are damaged.' >&2; return 65; }
  fi
  [[ ! -e $current || -L $current ]] ||
    { echo 'Existing scripts path is not a link.' >&2; return 73; }
  backup=/var/lib/teche/scriptsv1.0/legacy-$(date -u +%Y%m%dT%H%M%SZ)-$$
  for old in wd1.0-menu.sh wd1.0-uninstall.sh; do
    if [[ -f /usr/lib/teche/$old && ! -L /usr/lib/teche/$old ]]; then
      install -d -m 0700 "$backup"
      cp -a -- "/usr/lib/teche/$old" "$backup/$old"
    fi
  done
  link=$base/.current.$$
  ln -s "$release" "$link"
  mv -Tf -- "$link" "$current"
  for old in wd1.0-menu.sh wd1.0-uninstall.sh; do
    ln -sfn "$current/lib/$old" "/usr/lib/teche/$old"
  done
  install -d -m 0755 /var/lib/teche/scriptsv1.0
  printf '%s\n' "$commit" > /var/lib/teche/scriptsv1.0/source-commit
  printf 'TechE scripts %s active from public release commit %s\n' \
    "$(cat "$current/VERSION")" "$commit"
  refresh_succeeded=1
  log_event succeeded
}
if (( $# == 2 )) &&
   [[ ( $1 == get || $1 == update ) &&
      ( $2 == scripts || $2 == scriptsv1.0 ) ]]; then
  refresh "$@"
  exit 0
fi
if [[ -x $current/bin/teche ]]; then
  exec "$current/bin/teche" "$@"
fi
if (( $# == 0 )) || [[ ${1:-} == help || ${1:-} == --help || ${1:-} == -help || ${1:-} == -h ]]; then
  usage
  exit 0
fi
if (( $# == 1 )) && [[ $1 == ver || $1 == version || $1 == v || $1 == -v || $1 == --version ]]; then
  echo 'TechE platform v1.0; scriptsv1.0 not installed.'
  exit 0
fi
echo 'Run teche get scriptsv1.0 first.' >&2
exit 69
